# MCP Server Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# EXISTING API KEYS (already configured)
# =============================================================================

# Bureau of Economic Analysis
BEA_API_KEY=

# Census Bureau
CENSUS_API_KEY=

# USITC DataWeb
DATAWEB_TOKEN=

# GovInfo
GOVINFO_API_KEY=

# Regulations.gov
REGULATIONS_API_KEY=

# GNews (for news articles)
GNEWS_API_KEY=

# Google Gemini (for AI features)
GEMINI_API_KEY=

# =============================================================================
# NEW API KEYS FOR STATE REPORTS (Real Data)
# =============================================================================

# Bureau of Labor Statistics (unemployment, CPI, wages)
# Register at: https://www.bls.gov/developers/home.htm
# Free, instant registration, 500 requests/day
BLS_API_KEY=

# Federal Reserve Economic Data (GDP, personal income, economic indicators)
# Register at: https://fred.stlouisfed.org/ → My Account → API Keys
# Free, instant registration, 120 requests/minute
FRED_API_KEY=

# Energy Information Administration (electricity, gas, natural gas prices)
# Register at: https://www.eia.gov/opendata/register.php
# Free, instant registration, 1000 requests/hour
EIA_API_KEY=

# HUD Fair Market Rents (housing/rent data)
# Register at: https://www.huduser.gov/hudapi/public/register
# Free, requires 1-2 day approval, 1000 requests/day
HUD_API_TOKEN=

# USDA Economic Research Service (food prices)
# Optional - system works without it using public USDA data
# Contact: ERS-Data-Services@usda.gov
USDA_API_KEY=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Cache TTL in seconds
CACHE_TTL=300
