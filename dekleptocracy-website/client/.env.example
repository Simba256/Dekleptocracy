# API Configuration
# Backend API URL for development (defaults to localhost if not set)
VITE_API_URL=http://localhost:5000

# Production backend API URL
VITE_API_URL_PRODUCTION=https://node-server-production-7f39.up.railway.app

# Google OAuth (optional - enables Google Sign-In)
# Get your Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
